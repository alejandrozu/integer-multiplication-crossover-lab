  "exact_source_census_formulas": {
    "wide_multiply": "m*k",
    "limb_add": "4*m*k-2*m",
    "limb_compare": "2*m*k-m",
    "array_load": "2*m*k-m+k",
    "array_store": "m*k+k",
    "portable_half_multiply": "4*m*k",
    "portable_limb_add_after_expansion": "8*m*k-2*m+beta, 0<=beta<=m*k",
    "portable_compare_after_expansion": "3*m*k-m",
    "portable_macro_shift": "5*m*k",
    "portable_macro_mask": "3*m*k",
    "portable_macro_conditional_branches": "m*k",
    "inner_loop_comparisons_and_branches_each": "m*k",
    "outer_loop_comparisons_and_branches_each": "k"
  },
  "source_census_scope": "Counts the listed source operations, with macro branch-taken beta recorded on actual input. Register allocation, parameter passing, compiler scheduling, ABI prologue, allocation and CPU/cache costs are not estimated. This is not a full CPU instruction census.",
  "circuit_tariff": {
    "AND": 1,
    "XOR": "rho>0",
    "NOT": "one XOR with 1",
    "wires_fanout_constants_fixed_shifts_masks": 0
