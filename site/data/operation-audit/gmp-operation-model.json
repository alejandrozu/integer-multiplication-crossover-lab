  "primitive_circuits": {
    "modular_add_W": {
      "AND": "2W",
      "XOR": "3W",
      "description": "W unsimplified ripple full-adder cells, unused final carry still evaluated"
    },
    "unsigned_compare_W": {
      "AND": "2W",
      "XOR": "3W+1",
      "description": "carry-only ripple a+NOT(b)+1, then NOT carry gives a<b"
    },
    "q_by_q_to_2q_schoolbook": {
      "AND": "5q^2-4q",
      "XOR": "6q^2-6q",
      "description": "q^2 AND partial bits; first row direct; q-1 full 2q-bit ripple adds"
    },
    "portable_wide_64": {
      "AND": 20736,
      "XOR": 24961
    },
    "macro_branch_lowering": "if(c) x3+=2^32 becomes one unconditional x3+(c<<32), charged in the fixed circuit"
  },
  "complete_circuit_formulas_64": {
    "AND": "21504*m*k-384*m",
    "XOR": "26115*m*k-577*m",
    "work": "(21504*m*k-384*m)+rho*(26115*m*k-577*m)"
  },
  "model_caveats": [
    "A complete explicit arithmetic circuit, with its precise gate costs; not a claim of gate minimality or fastest known multiplication.",
    "All loops are unrolled by the uniform generator for public input lengths. Source pointer movement and loop control become circuit wiring/generation, not Boolean gates.",
    "This tariff makes fixed shifts/masks and memory movement wires free. CPU/Turing-machine movement costs require a different model.",
    "The selected all-size basecase has quadratic gate growth; actual GMP uses size-dependent Toom/FFT dispatch and is not represented by this curve.",
    "No complete comparable PR4470 circuit with numerical A_j and validity threshold is emitted; no PR4470-vs-GMP or HvH crossover is certified."
  ],
